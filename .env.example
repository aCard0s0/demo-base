# Copy to .env (git-ignored) and fill in. Names are the services' own environment bindings, so the same file
# drives compose and every service: load it into the shell before starting one from source with
#   set -a; . ./.env; set +a
# Anything left out falls back to the development default in each service's application.properties: enough for a
# laptop, wrong anywhere else. The admin, the internal secret and the header key must be set before going anywhere.

# Postgres superuser for the compose container. The per-service roles (auth/auth, todo/todo, agent/agent) come from
# docker/initdb.sql and are what the services connect with.
POSTGRES_PASSWORD=postgres

# The admin, created in auth-service's database the first time the stack starts with these set, and re-checked on
# every boot after that. Create-only: changing ADMIN_PASSWORD here does NOT reset an admin that already exists, so a
# stale .env cannot hand the user back. Change it from /profile, or `docker compose down --volumes` to start over.
# Blank seeds no admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-8-characters

# Sent by agent-service as X-Internal-Secret when it asks auth-service to mint a 30-day agent token; both read the
# same property, so one value serves both. Any long random string. Blank closes auth-service's /internal/agent-tokens.
AUTH_INTERNAL_SECRET=dev-internal-secret

# agent-service encrypts the authorization headers owners store on their MCP servers with this, AES-256-GCM. Any
# long random string; blank refuses to start; changing it after rows exist makes those headers unreadable.
AGENTS_AUTH_HEADER_KEY=dev-auth-header-key

# The MCP servers agent-service trusts, comma separated, compared exactly as written: an owner may attach them by
# their private name. Compose defaults to todo-service's.
# AGENTS_TRUSTED_SERVER_URLS=http://todo-service:9082/mcp

# The SMTP server that mails the links proving an address: at signup and on every change of email. Compose defaults
# to its Mailpit (read the mail at http://localhost:8025); with no host at all, signup and email changes are refused.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# AUTH_MAIL_FROM=no-reply@example.com
# Signs the links in that mail. Any string; blank makes a fresh one at every start, which voids the links that are
# out and keeps two instances from reading each other's.
AUTH_EMAIL_LINK_KEY=

# Sign-in with a provider. Every provider is off unless ENABLED is true AND every credential it needs is
# set -- half-filled credentials count as off, so a copied-and-unfinished .env draws no broken button.
#
# Step-by-step for getting a client id and secret from each provider, and for rotating one later:
#   apps/auth-service/README.md#getting-a-client-id-and-secret
#
# The short version -- register the callback URL with each provider exactly as written, host and port
# included, or it will refuse the redirect:
#   Google  console.cloud.google.com -> Google Auth Platform -> Clients -> Create client (Web application)
#           Authorized redirect URI:  http://localhost:3000/api/oauth/google/callback
#   GitHub  github.com/settings/developers -> OAuth apps -> New OAuth App
#           Authorization callback URL: http://localhost:3000/api/oauth/github/callback
#   Microsoft, Apple, X, LinkedIn, Discord: the same README, one section each. Apple needs HTTPS on a real
#           domain and a .p8 key rather than a secret; X needs the "Request email from users" app setting.
#
# Serving the frontend from somewhere other than localhost:3000 means changing OAUTH_REDIRECT_BASE_URL here
# and the registered URI there, together -- the provider rejects a redirect_uri it does not already know.
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

OAUTH_MICROSOFT_ENABLED=false
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Services ID, Team ID, Key ID, and the .p8 file's contents on one line with \n for the line breaks.
OAUTH_APPLE_ENABLED=false
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=

OAUTH_X_ENABLED=false
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=

OAUTH_LINKEDIN_ENABLED=false
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=

OAUTH_DISCORD_ENABLED=false
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
